# ─────────────────────────────────────────────────────────────────────────────
# CareerLens AI — environment configuration
#
# Copy to `.env.local` for development, or paste into your host's environment
# variable settings for production.
#
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
# Anthropic API key. This is the only variable the app needs to run.
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here


# ── Optional ─────────────────────────────────────────────────────────────────

# Claude model to use. Defaults to claude-haiku-4-5-20251001 (ADR-22), the
# cheapest current tier and the closest match to the previous Flash-tier cost
# profile. Override to roll the model forward without a code change.
#
# Note for any future tier change: do NOT add a `thinking` parameter to this
# call path. Structured output is forced tool use, and manual extended thinking
# is incompatible with a forced tool_choice.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Active AI provider. Only `anthropic` ships today; the abstraction in `lib/ai`
# exists so another vendor can be added without touching any call site.
# AI_PROVIDER=anthropic

# Voyage AI key, for the research embedding-similarity baseline ONLY (ADR-23).
# The deployed application never reads this and is fully functional without it —
# it is used solely by `research/scripts/baselines/embedding-similarity.ts`,
# which runs against synthetic dataset text.
# Create one at https://dashboard.voyageai.com
# VOYAGE_API_KEY=your_voyage_api_key_here

# Voyage embedding model. Defaults to voyage-4. Confirmed against Voyage's docs
# on 26 Aug 2026: voyage-4 ($0.06/MTok, 1024 dims, 32k context) with 200M free
# tokens; voyage-4-lite ($0.02) and voyage-4-large ($0.12) are the cheaper and
# stronger alternatives.
# VOYAGE_MODEL=voyage-4

# Canonical public origin, used for canonical links, Open Graph images, the
# sitemap and robots.txt. Leave unset on Vercel — the platform's own URL is
# detected automatically, so preview deployments describe themselves correctly.
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Allows /api/analyze to answer in research mode, which returns per-claim
# internals (match_score, hallucination_candidate) that the product never shows
# a user. A request must ALSO send `X-Research-Mode: 1` — the header alone is
# not authorization, since anyone can send a header.
#
# Leave unset in production. It exists for the evaluation scripts in research/,
# run against a local instance.
# RESEARCH_MODE_ENABLED=true
