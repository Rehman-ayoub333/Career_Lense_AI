# ─────────────────────────────────────────────────────────────────────────────
# CareerLens AI — environment configuration
#
# Copy to `.env.local` for development, or paste into your host's environment
# variable settings for production.
#
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
# Google AI Studio API key. This is the only variable the app needs to run.
# Create one free at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here


# ── Optional ─────────────────────────────────────────────────────────────────

# Gemini model to use. Defaults to gemini-2.5-flash, which is fast, inexpensive
# and supports the structured-output mode this app relies on. Override to roll
# the model forward without a code change.
# GOOGLE_MODEL=gemini-2.5-flash

# Active AI provider. Only `google` ships today; the abstraction in `lib/ai`
# exists so another vendor can be added without touching any call site.
# AI_PROVIDER=google

# Canonical public origin, used for canonical links, Open Graph images, the
# sitemap and robots.txt. Leave unset on Vercel — the platform's own URL is
# detected automatically, so preview deployments describe themselves correctly.
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Allows /api/analyze to answer in research mode, which returns per-claim
# internals (match_score, hallucination_candidate) that the product never shows
# a user. A request must ALSO send `X-Research-Mode: 1` — the header alone is
# not authorization, since anyone can send a header.
#
# Leave unset in production. It exists for the evaluation scripts in research/,
# run against a local instance.
# RESEARCH_MODE_ENABLED=true
