  "private": true,
  "description": "AI CV analyser that scores a CV against a job description or scholarship criteria.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "start": "next start",
